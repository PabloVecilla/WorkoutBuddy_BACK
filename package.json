{
  "name": "workoutBuddyAPI",
  "version": "1.0.0",
  "description": "API to support exercise app ",
  "main": "src/app.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node create-tables.js",
    "exercises:fetch": "node scripts/fetchExercises.js",
    "exercises:normalize": "node scripts/normalizeExercises.js",
    "exercises:prepare": "npm run exercises:fetch && npm run exercises:normalize",
    "exercises:seed": "node scripts/runExerciseSeeder",
    "db:migrate:develop": "NODE_ENV=development sequelize-cli db:migrate --env development",
    "db:migrate:develop:status": "NODE_ENV=development sequelize-cli db:migrate:status --env development",
    "db:migrate:develop:undo": "NODE_ENV=development sequelize-cli db:migrate:undo --env development",
    "db:migrate:test": "NODE_ENV=test sequelize-cli db:migrate --env test",
    "db:migrate:test:undo": "NODE_ENV=test sequelize-cli db:migrate:undo --env test",
    "db:migrate:prod": "NODE_ENV=production sequelize-cli db:migrate --env production",
    "db:migrate:prod:status": "NODE_ENV=production sequelize-cli db:migrate:status --env production",
    "test": "npm run db:migrate:test && NODE_ENV=test jest --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.14.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "follow-redirects": "^1.16.2",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "proxy-addr": "^2.0.8",
    "react-router-dom": "^7.18.5",
    "save-dev": "^0.0.1-security",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
